# Required server-side credentials (never NEXT_PUBLIC_)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
AGENT_ID=your_shria_agent_id
# Optional: set a token to require authorization on goal logging
TOOL_BEARER_TOKEN=
# Legacy only, not used for ElevenLabs signing
JWT_SECRET=
# Exact browser origins; omit to use the built-in localhost/production list
CORS_ALLOWLIST=http://localhost:3000,http://localhost:3001,https://7-days-to-calm.vercel.app,https://elevatedmovements.com,https://www.elevatedmovements.com
