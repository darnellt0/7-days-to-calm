PORT=4000
TZ=America/Los_Angeles
DATABASE_URL="file:./dev.db"
STORE=memory
ADMIN_TOKEN=

# comma-separated list of allowed origins for signed-url
CORS_ALLOWLIST=https://www.elevatedmovements.com,https://elevatedmovements.com

# Optional signing adapter: point at FastAPI, not this Express service
BACKEND_URL=http://localhost:8787
